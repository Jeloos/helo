-- ================== FARM TAB ==================
FarmTab:AddSection({Name = "Farm Controls"})

FarmTab:AddToggle({
    Name = "Auto Farm",
    Default = false,
    Callback = function(Value)
        running = Value
        OrionLib:MakeNotification({Name = "Farm", Content = running and "Auto Farm Started!" or "Auto Farm Stopped", Time = 3})
    end    
})

FarmTab:AddSlider({
    Name = "Buy Amount",
    Min = 1,
    Max = 25,
    Default = 1,
    Increment = 1,
    Callback = function(Value)
        buyAmount = Value
    end    
})

FarmTab:AddButton({
    Name = "Buy Now",
    Callback = function()
        for i = 1, buyAmount do
            buyRemote:FireServer("Water")
            buyRemote:FireServer("Sugar Block Bag")
            buyRemote:FireServer("Gelatin")
            buyRemote:FireServer("Empty Bag")
            task.wait(0.4)
        end
        OrionLib:MakeNotification({Name = "Buy", Content = "Pembelian selesai!", Time = 3})
    end    
})

FarmTab:AddToggle({
    Name = "Auto Sell",
    Default = false,
    Callback = function(Value)
        autoSellEnabled = Value
    end    
})

